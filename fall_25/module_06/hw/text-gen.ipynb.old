   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from scipy.stats import beta\n",
    "\n",
    "# Parameters for the distributions\n",
    "alpha_prior = 6\n",
    "beta_prior = 4\n",
    "\n",
    "n_W = 5\n",
    "n_L = 5\n",
    "\n",
    "alpha_post = alpha_prior + n_W  # 11\n",
    "beta_post = beta_prior + n_L   # 9\n",
    "\n",
    "# Create the x-axis (values of theta)\n",
    "x = np.linspace(0, 1, 400)\n",
    "\n",
    "# Calculate the PDF for prior and posterior\n",
    "prior_pdf = beta.pdf(x, alpha_prior, beta_prior)\n",
    "post_pdf = beta.pdf(x, alpha_post, beta_post)\n",
    "\n",
    "# Calculate the likelihood (scaled to plot nicely)\n",
    "# The shape is a Beta(n_W+1, n_L+1) PDF\n",
    "likelihood_pdf = beta.pdf(x, n_W + 1, n_L + 1)\n",
    "\n",
    "# Create the plot\n",
    "plt.figure(figsize=(10, 6))\n",
    "plt.plot(x, prior_pdf, 'b--', lw=2, \n",
    "         label=f'Prior: Beta({alpha_prior}, {beta_prior})')\n",
    "plt.plot(x, post_pdf, 'r-', lw=3, \n",
    "         label=f'Posterior: Beta({alpha_post}, {beta_post})')\n",
    "plt.plot(x, likelihood_pdf, 'g:', lw=2, \n",
    "         label=f'Likelihood (scaled): $\\propto \\\\theta^{n_W}(1-\\\\theta)^{n_L}$')\n",
    "\n",
    "# Add vertical lines for means\n",
    "plt.axvline(alpha_prior / (alpha_prior + beta_prior), \n",
    "            color='b', linestyle='--', lw=1, \n",
    "            label=f'Prior Mean: {0.6:.2f}')\n",
    "plt.axvline(alpha_post / (alpha_post + beta_post), \n",
    "            color='r', linestyle='-', lw=1, \n",
    "            label=f'Posterior Mean: {0.55:.2f}')\n",
    "plt.axvline(n_W / (n_W + n_L), color='g', linestyle=':', \n",
    "            lw=1, label=f'MLE (Likelihood Peak): {0.5:.2f}')\n",
    "\n",
    "# Add labels, title, and legend\n",
    "plt.xlabel('$\\\\theta$ (Probability of Win)', fontsize=12)\n",
    "plt.ylabel('Density', fontsize=12)\n",
    "plt.title('Bayesian Update: Prior, Likelihood, and Posterior', fontsize=14)\n",
    "plt.legend(fontsize=11)\n",
    "plt.grid(True, linestyle='--', alpha=0.6)\n",
    "plt.xlim(0, 1)\n",
    "\n",
    "# Save the figure\n",
    "plt.savefig('q8_d.png', dpi=150, bbox_inches='tight')\n",
    "print(\"Posterior density plot saved as 'q8_d.png'\")"
   ]
  },
