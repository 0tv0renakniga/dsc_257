   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from scipy.stats import poisson\n",
    "\n",
    "# Parameter from part (a)\n",
    "lambda_val = 3.154\n",
    "\n",
    "# k values from 0 to 10\n",
    "k_values = np.arange(0, 11)\n",
    "\n",
    "# Calculate Poisson PMF probabilities for each k\n",
    "probabilities = poisson.pmf(k_values, lambda_val)\n",
    "\n",
    "# --- MODIFIED ---\n",
    "# Create a Figure and an Axes object (the OO-interface)\n",
    "fig, ax = plt.subplots(figsize=(10, 6))\n",
    "\n",
    "# Create the bar plot on the 'ax' Axes\n",
    "# Store the returned 'bars' container\n",
    "bars = ax.bar(k_values, probabilities, color='skyblue', edgecolor='black')\n",
    "# --- END MODIFIED ---\n",
    "\n",
    "\n",
    "# --- NEW LINE TO ADD LABELS ---\n",
    "# Add labels on top of each bar in the 'bars' container\n",
    "# - fmt='%.3f' formats the label to 3 decimal places\n",
    "# - padding=3 adds a little space above the bar\n",
    "# - fontsize=9 makes the labels a bit smaller\n",
    "ax.bar_label(bars, fmt='%.3f', padding=3, fontsize=9)\n",
    "# --- END NEW LINE ---\n",
    "\n",
    "\n",
    "# --- MODIFIED ---\n",
    "# Add labels and title using the 'ax.set_' methods\n",
    "ax.set_xlabel('k (Number of Calls in one hour)', fontsize=12)\n",
    "ax.set_ylabel('Probability P(X=k)', fontsize=12)\n",
    "ax.set_title(f'Poisson PMF for $\\lambda = {lambda_val}$', fontsize=14)\n",
    "ax.set_xticks(k_values) # Ensure integer ticks on x-axis\n",
    "ax.grid(axis='y', linestyle='--', alpha=0.7)\n",
    "# --- END MODIFIED ---\n",
    "\n",
    "# Save the figure (using the 'fig' object)\n",
    "# I changed the filename so it doesn't overwrite your old one\n",
    "fig.savefig('poisson_pmf_with_labels.png', dpi=150, bbox_inches='tight')\n",
    "\n",
    "print(\"Poisson PMF plot saved as 'poisson_pmf_with_labels.png'\")\n",
    "# Print probabilities for reference\n",
    "for k, prob in zip(k_values, probabilities):\n",
    "    print(f\"P(X={k}) = {prob:.5f}\")\n",
    "\n",
    "# In a script or notebook, you would add this to see the plot:\n",
    "# plt.show()"
   ]
